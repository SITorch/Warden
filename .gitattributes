# Normalize line endings for text sources; keep binaries and the shipped BPF
# object byte-exact (its hash is a release invariant).
* text=auto eol=lf

*.rs    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.sh    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.service text eol=lf

# The prebuilt CO-RE object and generated BTF header must not be EOL-converted.
*.o     binary
*.bpf.o binary
vmlinux.h -text

# Shell scripts and Makefiles require LF regardless of contributor platform.
*.sh    text eol=lf
Makefile text eol=lf
